{
    "name": "tkhamez/neucore-mumble-plugin",
    "description": "",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "tkhamez/neucore-plugin": "^6.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpcompatibility/php-compatibility": "^10.0.0-alpha3"
    },
    "autoload": {
        "psr-4": {
            "Neucore\\Plugin\\Mumble\\": "src/",
            "Neucore\\Plugin\\Mumble\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --bootstrap vendor/autoload.php tests",
        "compat": "phpcs --standard=PHPCompatibility --runtime-set testVersion 8.1-8.5 --colors -p src tests"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
